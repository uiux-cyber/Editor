                {
                  "offset": 1,
                  "color": "#23262e"
                }
              ]
            }
          },
          "anim": {
            "in": {
              "id": "pop-in",
              "duration": 0.5
            },
            "out": {
              "id": "pop-out",
              "duration": 0.35
            }
          }
        }
      ]
    }
  ]
}
